[Unit]
Description=gittr homepage platform leaderboard snapshot refresh
Documentation=file:///opt/ngit/docs/SETUP_INSTRUCTIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ngit/ui
EnvironmentFile=-/etc/default/gittr-leaderboard-refresh
# Own process (tsx) — does NOT curl live Next.
ExecStart=/bin/bash -c 'set -euo pipefail; set -a; [ -f /opt/ngit/ui/.env.local ] && . /opt/ngit/ui/.env.local; set +a; exec /usr/bin/npx --yes tsx /opt/ngit/scripts/refresh-platform-leaderboard.mts'
MemoryMax=1200M
Nice=10
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gittr-leaderboard-refresh

[Install]
WantedBy=multi-user.target
