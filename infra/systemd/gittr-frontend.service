[Unit]
Description=gittr Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ngit/ui
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
# 15 Gi hosts: room to breathe; still restart before a runaway process fills the box.
MemoryHigh=3G
MemoryMax=4G
OOMPolicy=stop
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=3072
Environment="GIT_NOSTR_BRIDGE_REPOS_DIR=/home/git-nostr/git-nostr-repositories"
Environment="HOME=/root"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
