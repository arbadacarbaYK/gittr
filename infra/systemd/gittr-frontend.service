[Unit]
Description=gittr Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ngit/ui
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
# 3.7 Gi hosts: kill/restart Next *before* it wedges (~1.9 Gi RSS was already dead).
MemoryHigh=1400M
MemoryMax=1800M
OOMPolicy=stop
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment="GIT_NOSTR_BRIDGE_REPOS_DIR=/home/git-nostr/git-nostr-repositories"
Environment="HOME=/root"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
