## Root environment (optional backend/bridge services)
## For Next.js frontend use ui/.env.local (see ui/.env.example)

# Server-side integrations
# LNBITS_URL may be used as a default base URL; do NOT set LNBITS_ADMIN_KEY —
# payment APIs require the user's key from Settings (no server-key spend).
LNBITS_URL=
# LNBITS_ADMIN_KEY=  # unused / dangerous if set for open payment routes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub OAuth / platform token (server-side API)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PLATFORM_TOKEN=
GITHUB_REDIRECT_URI=

# Public runtime config (if you prefer root .env for Next.js)
NEXT_PUBLIC_SITE_URL=https://gittr.space
NEXT_PUBLIC_API_URL=https://gittr.space
NEXT_PUBLIC_DOMAIN=gittr.space
NEXT_PUBLIC_PROTOCOL=https
NEXT_PUBLIC_GIT_SERVER_URL=https://git.gittr.space
NEXT_PUBLIC_GIT_SSH_BASE=git.gittr.space
# gittr open Pyramid adaptation (https://github.com/arbadacarbaYK/pyramid — FORGE.md)
NEXT_PUBLIC_NOSTR_RELAYS=wss://relay.gittr.space,wss://git.shakespeare.diy,wss://gitnostr.com,wss://relay.ngit.dev,wss://ngit.danconwaydev.com,wss://relay.damus.io,wss://nos.lol,wss://relay.azzamo.net,wss://nostr.mom,wss://nostr.wine,wss://relay.snort.social,wss://relay.nostr.info,wss://relay.noderunners.network,wss://relay.primal.net,wss://purplepag.es,wss://relay.nostr.net
NEXT_PUBLIC_BLOSSOM_URL=
NEXT_PUBLIC_PLATFORM_PUBKEY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_RELAY_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SYSTEM_NSEC=
NEXT_PUBLIC_SYSTEM_NPUB=

# Backend/bridge-only config
NWC_URI=
BLOSSOM_URL=
RELAYS=wss://relay.damus.io,wss://nos.lol,wss://nostr.wine
NOSTR_NSEC_1=
NOSTR_NSEC_2=

# Security audit UI (repo badge, help topic, settings toggle). Keep off until
# the platform's own dependency tree scans clean — see docs/SETUP_INSTRUCTIONS.md.
NEXT_PUBLIC_SECURITY_AUDIT_UI=0

# CVE alert bot (npx tsx scripts/cve-bot.mts). Production: CVE_BOT_ENABLED=1 in
# /etc/default/gittr-cve-bot (never upload that file or /opt/ngit/data from laptop).
# CVE_BOT_ENABLED=1
# CVE_BOT_RELAYS=wss://relay.gittr.space,wss://relay.damus.io,wss://nos.lol
# NOSTR_NSEC=  # platform signer (also used by /api/notifications/send)
# GITTR_BASE=https://gittr.space
# CVE_BOT_DEDUP_PATH=/opt/ngit/data/cve-bot-dedup.json
# CVE_BOT_PENDING_PATH=/opt/ngit/data/cve-bot-pending.json
# NOTIFICATIONS_CONSENT_PATH=/opt/ngit/data/notifications-consent.json
